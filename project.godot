; Mochi Arcade — Godot 4.7.2 stable, Compatibility renderer.
config_version=5

[application]
config/name="Mochi Arcade"
config/version="1.0.0"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Eight little games. A softer kind of play."
config/icon="res://assets/art/app-icon.svg"
boot_splash/bg_color=Color(0.984314, 0.952941, 0.886275, 1)
boot_splash/fullsize=true
boot_splash/image="res://assets/art/boot-splash.png"
boot_splash/show_image=true
boot_splash/use_filter=true

[autoload]
Save="*res://scripts/app/save_manager.gd"
Sound="*res://scripts/app/audio_manager.gd"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.988, 0.969, 0.933, 1)
textures/canvas_textures/default_texture_filter=2
textures/vram_compression/import_etc2_astc=true
